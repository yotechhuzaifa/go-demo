# Copy this file to `.env` and fill in real values.
# `.env` is Git-ignored; this example contains no secrets.

APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=debug
LOG_FORMAT=text
# Colors for the text format: auto (only when stdout is a terminal), always, never.
LOG_COLOR=auto

# PostgreSQL (schema `taskflow` is created by the project)
POSTGRES_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
POSTGRES_SCHEMA=taskflow

# MongoDB (database `taskflow` is created by the project on first write)
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/?retryWrites=true&w=majority
MONGO_DATABASE=taskflow
MONGO_CONNECT_TIMEOUT=10s

# Redis
REDIS_ADDR=HOST:PORT
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# Retry / resilience
DB_CONNECT_ATTEMPTS=5
DB_CONNECT_RETRY_DELAY=2s
REDIS_RETRY_ATTEMPTS=4
REDIS_RETRY_DELAY=250ms

# Behaviour
AUTO_MIGRATE=true
SEED_DEMO_DATA=true
CACHE_TTL=5m
