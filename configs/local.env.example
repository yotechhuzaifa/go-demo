# Legacy location for local configuration.
#
# The preferred file is `.env` in the repository root; the application loads it
# automatically with godotenv. This file is still loaded as a fallback for
# backwards compatibility.
#
# Copy the root example instead:
#
#   cp .env.example .env
#
# See .env.example for the full, documented list of variables.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_COLOR=auto

POSTGRES_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
POSTGRES_SCHEMA=taskflow

MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/?retryWrites=true&w=majority
MONGO_DATABASE=taskflow
MONGO_CONNECT_TIMEOUT=10s

REDIS_ADDR=HOST:PORT
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

DB_CONNECT_ATTEMPTS=5
DB_CONNECT_RETRY_DELAY=2s
REDIS_RETRY_ATTEMPTS=4
REDIS_RETRY_DELAY=250ms
CACHE_TTL=5m
AUTO_MIGRATE=true
SEED_DEMO_DATA=true
